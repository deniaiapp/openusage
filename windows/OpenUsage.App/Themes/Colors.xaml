<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgDark">#1C1C1E</Color>
    <Color x:Key="CardDark">#2C2C2E</Color>
    <Color x:Key="TextDark">#F5F5F7</Color>
    <Color x:Key="MutedDark">#8E8E93</Color>
    <Color x:Key="TrackDark">#3A3A3C</Color>

    <Color x:Key="BgLight">#F2F2F7</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="TextLight">#1C1C1E</Color>
    <Color x:Key="MutedLight">#6C6C70</Color>
    <Color x:Key="TrackLight">#E5E5EA</Color>

    <SolidColorBrush x:Key="MeterNormal" Color="#0A84FF"/>
    <SolidColorBrush x:Key="MeterWarning" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="MeterCritical" Color="#FF453A"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
</ResourceDictionary>

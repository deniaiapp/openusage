<Window x:Class="OpenUsage.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenUsage"
        Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated">
    <Border x:Name="RootBorder"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            VerticalAlignment="Bottom"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TopBar" Grid.Row="0" Height="44" Visibility="Collapsed" Margin="6,4,6,0">
                <Button x:Name="BackButton" Content="‹ Back" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="OnBack" FontWeight="SemiBold"/>
                <TextBlock x:Name="TopTitle" Text="Customize" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="DashboardTabs" Grid.Row="1" Orientation="Horizontal"
                        Margin="14,10,14,0" Visibility="Collapsed"
                        AutomationProperties.Name="Dashboard View">
                <RadioButton x:Name="PriorityTab" Content="Priority" GroupName="DashboardTabs"
                             Foreground="{DynamicResource TextBrush}" Click="OnDashboardTabChanged"
                             Margin="0,0,12,0"/>
                <RadioButton Content="All Usage" GroupName="DashboardTabs" IsChecked="True"
                             Foreground="{DynamicResource TextBrush}" Click="OnDashboardTabChanged"/>
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Padding="14,10,14,8">
                <StackPanel x:Name="ContentHost"/>
            </ScrollViewer>

            <Border Grid.Row="3" Padding="14,8,14,12">
                <Grid>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="RefreshLabel" Style="{StaticResource MutedText}" Cursor="Hand"
                                   MouseLeftButtonUp="OnRefreshClick"/>
                    </StackPanel>
                    <Button x:Name="OptionsButton" Content="Options" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOptions"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenUsage.App</RootNamespace>
    <AssemblyName>OpenUsage</AssemblyName>
    <ApplicationIcon>Assets\openusage.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenUsage.Core\OpenUsage.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.4.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.svg" />
    <Resource Include="..\..\Sources\OpenUsage\Resources\ProviderIcons\amp.svg" Link="Assets\amp.svg" />
    <Resource Include="Assets\openusage.ico" />
    <Resource Include="..\..\Sources\OpenUsage\Resources\ProviderIcons\muse.svg" Link="Assets\muse.svg" />
  </ItemGroup>
</Project>
